<div data-component='campaign-sidebar-cta' class='su-relative'>
    <div class='su-h-10 su-bg-gradient-report'></div>
    <img
        class='su-rs-mb-0 su-w-full'
        src='{{imageData.url}}'
        alt='{{imageData.attributes.alt.value}}'
    />

    <div class='su-rs-mb-1'>
        <h2 class='su-font-serif su-fluid-type-1 su-mb-10'>
            {{title}}
        </h2>

        <div class='su-card-paragraph'>{{description}}</div>
    </div>

    {{#if buttonUrl}}
        <a
            href='{{buttonUrl}}'
            {{#if isRealExternalLink}}rel='noopener nofollow'{{/if}}
            class='su-group su-button su-stretched-link su-text-16 md:su-text-20'
        >
            {{linkText}}
            {{#if isRealExternalLink}}
                {{> fontawesome-icon
                    icon="arrow-up"
                    set="regular"
                    width=20
                    classes="fa-fw su-inline-block su-shrink-0 su-text-white group-hocus:su-text-white su-text-[0.9em] su-ml-04em su-transition-transform su-rotate-45 group-hocus:su-translate-x-01em group-hocus:su--translate-y-01em"
                    iconUniqueID=iconUniqueID
                }}
            {{/if}}
        </a>
    {{/if}}

</div>